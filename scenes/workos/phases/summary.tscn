[node name="Summary" type="Label" parent="."]
layout_mode = 2
text = "Resumo do expediente"
autowrap_mode = 3

[node name="Instructions" type="Label" parent="."]
layout_mode = 2
text = "Setas: mover documento · Espaço: acelerar queda · Delete: descartar\nEsc: planilha/pausa · Pendências: mouse e teclado"
autowrap_mode = 3

[node name="Start" type="Button" parent="."]
layout_mode = 2
text = "Começar expediente"

[node name="Calendar" type="Button" parent="."]
layout_mode = 2
text = "Abrir calendário"
