[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/workos/theme.tres" id="theme"]

[node name="DaySummary" type="VBoxContainer"]
offset_right = 1180.0
offset_bottom = 550.0
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="."]
