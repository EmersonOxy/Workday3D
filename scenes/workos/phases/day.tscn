[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/workos/theme.tres" id="theme"]

[ext_resource type="Script" path="res://scripts/workos/work_board.gd" id="board"]

[node name="WorkingDay" type="VBoxContainer"]
offset_right = 1180.0
offset_bottom = 550.0
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
theme_override_constants/separation = 10

[node name="HUD" type="Label" parent="."]
layout_mode = 2
text = "Dia 1 · Pontuação · Estresse · Saldo"

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Pause" type="Button" parent="Toolbar"]
layout_mode = 2
text = "Pausar / continuar"

[node name="Spreadsheet" type="Button" parent="Toolbar"]
layout_mode = 2
text = "Planilha"

[node name="Coffee" type="Button" parent="Toolbar"]
layout_mode = 2
text = "Café"

[node name="Desktop" type="Button" parent="Toolbar"]
layout_mode = 2
text = "WorkOS"

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="Left" type="VBoxContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Board" type="Control" parent="Body/Left"]
layout_mode = 2
size_flags_vertical = 3
size_flags_horizontal = 3
script = ExtResource("board")

[node name="Controls" type="HBoxContainer" parent="Body/Left"]
layout_mode = 2

[node name="Left" type="Button" parent="Body/Left/Controls"]
layout_mode = 2
text = "←"

[node name="Drop" type="Button" parent="Body/Left/Controls"]
layout_mode = 2
text = "Soltar"

[node name="Right" type="Button" parent="Body/Left/Controls"]
layout_mode = 2
text = "→"

[node name="Delete" type="Button" parent="Body/Left/Controls"]
layout_mode = 2
text = "Excluir"

[node name="Coffee" type="Button" parent="Body/Left/Controls"]
layout_mode = 2
text = "Pegar café"

[node name="Events" type="VBoxContainer" parent="Body/Left"]
layout_mode = 2

[node name="TaskScroll" type="ScrollContainer" parent="Body"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(370, 0)

[node name="Tasks" type="VBoxContainer" parent="Body/TaskScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Status" type="Label" parent="."]
layout_mode = 2
text = "Organize as bandejas e acompanhe os prazos."
